---
const { title = "84Hz", description = "" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-size: 16px;
      }

      body {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        background: #ffffff;
        color: #111111;
        line-height: 1.8;
      }

      header {
        max-width: 900px;
        margin: 48px auto;
        padding: 0 24px;

        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      nav {
        display: flex;
        gap: 28px;
      }

      nav a {
        text-decoration: none;
        color: #666;
        transition: color .2s;
      }

      nav a:hover {
        color: #111;
      }

      .logo {
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: -.04em;
      }

      .logo a{
        text-decoration:none;
        color:#111;
      }

      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 24px 100px;
      }

      h1{
        font-size:3.5rem;
        letter-spacing:-.05em;
        margin-bottom:20px;
      }

      h2{
        margin-top:72px;
        margin-bottom:24px;
        letter-spacing:-.03em;
      }

      p{
        font-size:1.1rem;
        color:#444;
        margin-bottom:28px;
      }

      blockquote{
        border-left:3px solid #111;
        padding-left:24px;
        margin:48px 0;
        font-size:1.4rem;
        color:#111;
      }

      footer{
        max-width:900px;
        margin:80px auto 40px;
        padding:0 24px;
        color:#777;
        font-size:.95rem;
      }

      @media(max-width:768px){

        header{
          flex-direction:column;
          gap:20px;
          align-items:flex-start;
        }

        nav{
          flex-wrap:wrap;
          gap:16px;
        }

        h1{
          font-size:2.5rem;
        }

      }

    </style>
  </head>

  <body>

    <header>

      <div class="logo">
        <a href="/">84Hz</a>
      </div>

      <nav>
        <a href="/why-systems">Why Systems?</a>
        <a href="/essays">Essays</a>
        <a href="/frameworks">Frameworks</a>
        <a href="/about">About</a>
      </nav>

    </header>

    <main>

      <slot />

    </main>

    <footer>

      Thinking in public. Building with intention.

    </footer>

  </body>
</html>